            // \uc0\u1058 \u1077 \u1089 \u1090  \u1074 \u1083 \u1072 \u1089 \u1090 \u1080 \u1074 \u1086 \u1089 \u1090 \u1110  \u1090 \u1072  \u1084 \u1077 \u1090 \u1086 \u1076 \u1110 \u1074 \
