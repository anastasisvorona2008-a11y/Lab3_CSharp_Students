            Console.WriteLine(sensor1);\
\
\
            Console.WriteLine("\\n\uc0\u1058 \u1045 \u1057 \u1058 \u1059 \u1042 \u1040 \u1053 \u1053 \u1071  \u1047 \u1040 \u1042 \u1044 \u1040 \u1053 \u1053 \u1071  2 (JSON)");\
            \
