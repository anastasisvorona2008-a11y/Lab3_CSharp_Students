            Console.WriteLine($"\uc0\u1050 \u1110 \u1083 \u1100 \u1082 \u1110 \u1089 \u1090 \u1100  \u1076 \u1072 \u1090 \u1095 \u1080 \u1082 \u1110 \u1074  \u1087 \u1110 \u1089 \u1083 \u1103  \u1089 \u1090 \u1074 \u1086 \u1088 \u1077 \u1085 \u1085 \u1103 : \{TemperatureSensor.GetSensorCount()\}\\n");\
