\
        // \uc0\u1050 \u1086 \u1085 \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1086 \u1088  \u8470 1: \u1047  \u1087 \u1086 \u1095 \u1072 \u1090 \u1082 \u1086 \u1074 \u1086 \u1102  \u1090 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1086 \u1102 \
        public TemperatureSensor(double initialTemperature, double minLimit, double maxLimit)\
        \{\
            _sensorCount++; \
            _id = _sensorCount; // \uc0\u1055 \u1088 \u1080 \u1089 \u1074 \u1086 \u1102 \u1108 \u1084 \u1086  \u1091 \u1085 \u1110 \u1082 \u1072 \u1083 \u1100 \u1085 \u1080 \u1081  \u1085 \u1086 \u1084 \u1077 \u1088 \
            _currentTemperature = initialTemperature;\
            _minLimit = minLimit;\
            _maxLimit = maxLimit;\
        \}\
\
        // \uc0\u1050 \u1086 \u1085 \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1086 \u1088  \u8470 2: \u1041 \u1077 \u1079  \u1087 \u1086 \u1095 \u1072 \u1090 \u1082 \u1086 \u1074 \u1086 \u1111  \u1090 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1080  (\u1074 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1083 \u1102 \u1108 \u1090 \u1100 \u1089 \u1103  \u1074  0)\
        public TemperatureSensor(double minLimit, double maxLimit) \
            : this(0.0, minLimit, maxLimit)\
        \{\
        \}\
\
        // \uc0\u1057 \u1087 \u1077 \u1094 \u1110 \u1072 \u1083 \u1100 \u1085 \u1080 \u1081  \u1082 \u1086 \u1085 \u1089 \u1090 \u1088 \u1091 \u1082 \u1090 \u1086 \u1088  \u1076 \u1083 \u1103  \u1076 \u1077 \u1089 \u1077 \u1088 \u1110 \u1072 \u1083 \u1110 \u1079 \u1072 \u1094 \u1110 \u1111  JSON (\u1076 \u1086 \u1079 \u1074 \u1086 \u1083 \u1103 \u1108  \u1074 \u1110 \u1076 \u1085 \u1086 \u1074 \u1080 \u1090 \u1080  private readonly \u1087 \u1086 \u1083 \u1103 )\
        [JsonConstructor]\
        private TemperatureSensor(int id, double currentTemperature, double minLimit, double maxLimit)\
        \{\
            _id = id;\
            _currentTemperature = currentTemperature;\
            _minLimit = minLimit;\
            _maxLimit = maxLimit;\
            \
            // \uc0\u1071 \u1082 \u1097 \u1086  \u1074 \u1110 \u1076 \u1085 \u1086 \u1074 \u1083 \u1077 \u1085 \u1080 \u1081  ID \u1073 \u1110 \u1083 \u1100 \u1096 \u1080 \u1081  \u1079 \u1072  \u1087 \u1086 \u1090 \u1086 \u1095 \u1085 \u1080 \u1081  \u1083 \u1110 \u1095 \u1080 \u1083 \u1100 \u1085 \u1080 \u1082 , \u1082 \u1086 \u1088 \u1080 \u1075 \u1091 \u1102  \u1083 \u1110 \u1095 \u1080 \u1083 \u1100 \u1085 \u1080 \u1082 \
        \
            if (id > _sensorCount)\
            \{\
                _sensorCount = id;\
            \}\
        \}\
\
        // \uc0\u1052 \u1077 \u1090 \u1086 \u1076  \u1086 \u1085 \u1086 \u1074 \u1083 \u1077 \u1085 \u1085 \u1103  \u1090 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1080 \
        public void UpdateTemperature(double newTemperature)\
        \{\
            _currentTemperature = newTemperature;\
            Console.WriteLine($"[\uc0\u1044 \u1072 \u1090 \u1095 \u1080 \u1082  #\{_id\}]: \u1058 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1091  \u1086 \u1085 \u1086 \u1074 \u1083 \u1077 \u1085 \u1086  \u1076 \u1086  \{_currentTemperature\}\'b0C");\
        \}\
\
        // \uc0\u1052 \u1077 \u1090 \u1086 \u1076  \u1087 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1082 \u1080 , \u1095 \u1080  \u1079 \u1085 \u1072 \u1093 \u1086 \u1076 \u1080 \u1090 \u1100 \u1089 \u1103  \u1079 \u1085 \u1072 \u1095 \u1077 \u1085 \u1085 \u1103  \u1074  \u1076 \u1086 \u1087 \u1091 \u1089 \u1090 \u1080 \u1084 \u1080 \u1093  \u1084 \u1077 \u1078 \u1072 \u1093 \
        public bool IsTemperatureSafe()\
        \{\
            return _currentTemperature >= _minLimit && _currentTemperature <= _maxLimit;\
        \}\
\
        // \uc0\u1057 \u1090 \u1072 \u1090 \u1080 \u1095 \u1085 \u1080 \u1081  \u1084 \u1077 \u1090 \u1086 \u1076  \u1076 \u1083 \u1103  \u1086 \u1090 \u1088 \u1080 \u1084 \u1072 \u1085 \u1085 \u1103  \u1082 \u1110 \u1083 \u1100 \u1082 \u1086 \u1089 \u1090 \u1110  \u1089 \u1090 \u1074 \u1086 \u1088 \u1077 \u1085 \u1080 \u1093  \u1076 \u1072 \u1090 \u1095 \u1080 \u1082 \u1110 \u1074 \
        public static int GetSensorCount()\
        \{\
            return _sensorCount;\
