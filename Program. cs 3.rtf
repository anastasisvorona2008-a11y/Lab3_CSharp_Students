            Console.WriteLine($"\uc0\u1055 \u1086 \u1095 \u1072 \u1090 \u1082 \u1086 \u1074 \u1072  \u1082 \u1110 \u1083 \u1100 \u1082 \u1110 \u1089 \u1090 \u1100  \u1076 \u1072 \u1090 \u1095 \u1080 \u1082 \u1110 \u1074  \u1091  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1110 : \{TemperatureSensor.GetSensorCount()\}");\
