    public class TemperatureSensor\
    \{\
        // \uc0\u1057 \u1090 \u1072 \u1090 \u1080 \u1095 \u1085 \u1077  \u1087 \u1086 \u1083 \u1077  \u1076 \u1083 \u1103  \u1087 \u1110 \u1076 \u1088 \u1072 \u1093 \u1091 \u1085 \u1082 \u1091  \u1082 \u1110 \u1083 \u1100 \u1082 \u1086 \u1089 \u1090 \u1110  \u1089 \u1090 \u1074 \u1086 \u1088 \u1077 \u1085 \u1080 \u1093  \u1076 \u1072 \u1090 \u1095 \u1080 \u1082 \u1110 \u1074 \
        private static int _sensorCount = 0;\
\
        // \uc0\u1055 \u1088 \u1080 \u1093 \u1086 \u1074 \u1072 \u1085 \u1110  \u1087 \u1086 \u1083 \u1103  (private) \u1079  \u1072 \u1090 \u1088 \u1080 \u1073 \u1091 \u1090 \u1072 \u1084 \u1080  \u1076 \u1083 \u1103  JSON\
        [JsonInclude] private readonly int _id; \
        [JsonInclude] private double _currentTemperature;\
        [JsonInclude] private double _minLimit;\
        [JsonInclude] private double _maxLimit;\
\
        // \uc0\u1042 \u1083 \u1072 \u1089 \u1090 \u1080 \u1074 \u1110 \u1089 \u1090 \u1100  \u1090 \u1110 \u1083 \u1100 \u1082 \u1080  \u1076 \u1083 \u1103  \u1095 \u1080 \u1090 \u1072 \u1085 \u1085 \u1103  \u1076 \u1083 \u1103  \u1086 \u1090 \u1088 \u1080 \u1084 \u1072 \u1085 \u1085 \u1103  \u1087 \u1086 \u1090 \u1086 \u1095 \u1085 \u1086 \u1111  \u1090 \u1077 \u1084 \u1087 \u1077 \u1088 \u1072 \u1090 \u1091 \u1088 \u1080  (property get)\
        [JsonIgnore]\
        public double CurrentTemperature\
        \{\
            get \{ return _currentTemperature; \}\
