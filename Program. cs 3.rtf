\
        // \uc0\u1055 \u1077 \u1088 \u1077 \u1074 \u1080 \u1079 \u1085 \u1072 \u1095 \u1077 \u1085 \u1085 \u1103  \u1084 \u1077 \u1090 \u1086 \u1076 \u1091  ToString()\
        public override string ToString()\
        \{\
            string status = IsTemperatureSafe() ? "\uc0\u1053 \u1054 \u1056 \u1052 \u1040 " : "\u1059 \u1042 \u1040 \u1043 \u1040 ! \u1053 \u1045 \u1041 \u1045 \u1047 \u1055 \u1045 \u1050 \u1040 ";\
            return $"\uc0\u1044 \u1072 \u1090 \u1095 \u1080 \u1082  #\{_id\} | \u1055 \u1086 \u1090 \u1086 \u1095 \u1085 \u1072  t: \{_currentTemperature\}\'b0C | \u1052 \u1077 \u1078 \u1110 : [\{_minLimit\}\'b0C ... \{_maxLimit\}\'b0C] | \u1057 \u1090 \u1072 \u1090 \u1091 \u1089 : \{status\}";\
        \}\
\
        // \uc0\u1047 \u1040 \u1042 \u1044 \u1040 \u1053 \u1053 \u1071  2: \u1052 \u1045 \u1058 \u1054 \u1044 \u1048  JSON \u1057 \u1045 \u1056 \u1030 \u1040 \u1051 \u1030 \u1047 \u1040 \u1062 \u1030 \u1031 \
\
        // \uc0\u1052 \u1077 \u1090 \u1086 \u1076  1. \u1047 \u1073 \u1077 \u1088 \u1110 \u1075 \u1072 \u1108  \u1089 \u1090 \u1074 \u1086 \u1088 \u1077 \u1085 \u1080 \u1081  \u1086 \u1073 \'92\u1108 \u1082 \u1090  \u1082 \u1083 \u1072 \u1089 \u1091  \u1091  JSON \u1092 \u1072 \u1081 \u1083  \
        public static void SaveToJson(string filePath, TemperatureSensor sensor)\
        \{\
            var options = new JsonSerializerOptions \{ WriteIndented = true \};\
            string jsonString = JsonSerializer.Serialize(sensor, options);\
            File.WriteAllText(filePath, jsonString);\
            Console.WriteLine($"[\uc0\u1057 \u1080 \u1089 \u1090 \u1077 \u1084 \u1072 ]: \u1044 \u1072 \u1090 \u1095 \u1080 \u1082  #\{sensor._id\} \u1091 \u1089 \u1087 \u1110 \u1096 \u1085 \u1086  \u1079 \u1073 \u1077 \u1088 \u1077 \u1078 \u1077 \u1085 \u1086  \u1091  \u1092 \u1072 \u1081 \u1083  '\{filePath\}'.");\
        \}\
\
        // \uc0\u1052 \u1077 \u1090 \u1086 \u1076  2. \u1042 \u1110 \u1076 \u1082 \u1088 \u1080 \u1074 \u1072 \u1108  JSON \u1092 \u1072 \u1081 \u1083  \u1079  \u1076 \u1072 \u1085 \u1080 \u1084 \u1080  \u1090 \u1072  \u1089 \u1090 \u1074 \u1086 \u1088 \u1102 \u1108  \u1086 \u1073 \'92\u1108 \u1082 \u1090  \u1082 \u1083 \u1072 \u1089 \u1091 \
        public static TemperatureSensor LoadFromJson(string filePath)\
        \{\
            if (!File.Exists(filePath))\
            \{\
                throw new FileNotFoundException($"\uc0\u1060 \u1072 \u1081 \u1083  \{filePath\} \u1085 \u1077  \u1079 \u1085 \u1072 \u1081 \u1076 \u1077 \u1085 \u1086 !");\
            \}\
\
            string jsonString = File.ReadAllText(filePath);\
            TemperatureSensor deserializedSensor = JsonSerializer.Deserialize<TemperatureSensor>(jsonString);\
            Console.WriteLine($"[\uc0\u1057 \u1080 \u1089 \u1090 \u1077 \u1084 \u1072 ]: \u1044 \u1072 \u1090 \u1095 \u1080 \u1082  \u1091 \u1089 \u1087 \u1110 \u1096 \u1085 \u1086  \u1079 \u1072 \u1074 \u1072 \u1085 \u1090 \u1072 \u1078 \u1077 \u1085 \u1086  \u1090 \u1072  \u1089 \u1090 \u1074 \u1086 \u1088 \u1077 \u1085 \u1086  \u1079  \u1092 \u1072 \u1081 \u1083 \u1091  '\{filePath\}'.");\
            return deserializedSensor;\
        \}\
    \}\
